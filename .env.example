# Copy to .env to override defaults (see backend/src/finboard/core/config.py).
# The defaults already match deploy/compose.dev.yaml, so local development needs no .env.

# FINBOARD_MODE=local
# FINBOARD_PORT=8765
# FINBOARD_DATABASE_URL=postgresql+asyncpg://finboard_app:finboard_app_dev@127.0.0.1:55432/finboard
# FINBOARD_MIGRATION_DATABASE_URL=postgresql+asyncpg://finboard_owner:finboard_owner_dev@127.0.0.1:55432/finboard
# FINBOARD_REDIS_URL=redis://127.0.0.1:56379/0
# FINBOARD_LOG_LEVEL=INFO
# FINBOARD_LOG_JSON=false
